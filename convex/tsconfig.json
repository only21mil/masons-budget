{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // shared/domain is module:NodeNext and must write explicit .ts
    // extensions. Without this, `convex deploy` fails on a module that is
    // correct for its own build. Legal only alongside noEmit, which is set.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "convex/_generated/*": ["./_generated/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // Tests are not deployed functions. Excluding them here scopes the deploy
  // typecheck to what actually ships; convex/tsconfig.test.json still checks
  // them, wired into CI so they cannot rot silently.
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test-stub.ts"]
}
