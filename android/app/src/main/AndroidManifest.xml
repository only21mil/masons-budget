<?xml version="1.0" encoding="utf-8"?>
<!--
  Exactly one permission is declared, deliberately.

  Adding a permission here is a review event, not a convenience: the app handles
  family financial data and its attack surface should stay at zero until a
  feature genuinely needs one. Still no storage, camera, microphone, location,
  contacts or background access, and nothing that prompts the user.

  INTERNET is justified now because the Convex read-token cutover needs an
  Android client that can send the token (see data/ConvexConfig.kt). The read
  path is disabled by default and unwired, so this build still renders only the
  sanitized fixtures — but HttpURLConnection throws SecurityException without
  this line, which would make the plumbing impossible to exercise on a device,
  and burying the permission inside a later UI change would hide precisely the
  review event this comment exists to force.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VogelVault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.VogelVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
