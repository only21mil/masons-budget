<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ledger_terminal_background">#FF050505</color>

    <!--
      Terminal Ledger splash so launch does not flash white into a dark UI.
      Compose owns everything after that.
    -->
    <style name="Theme.VogelVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ledger_terminal_background</item>
        <item name="android:statusBarColor">@color/ledger_terminal_background</item>
        <item name="android:navigationBarColor">@color/ledger_terminal_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
