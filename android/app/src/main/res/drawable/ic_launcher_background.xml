<?xml version="1.0" encoding="utf-8"?>
<!--
  Vault door face. Deep graphite rather than pure black so the icon reads as an
  object on a black launcher wallpaper instead of a floating orange glyph.
  A faint radial lift centres the eye; no gloss, no bevel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#111114"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Subtle centre lift. Kept well inside the 72dp safe zone. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="52"
                android:startColor="#1C1C20"
                android:endColor="#0B0B0D" />
        </aapt:attr>
    </path>

    <!-- Machined ring, off-centre-safe: the launcher may mask to a circle. -->
    <path
        android:strokeColor="#26262C"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M54,20 A34,34 0 1,1 53.99,20" />
</vector>
