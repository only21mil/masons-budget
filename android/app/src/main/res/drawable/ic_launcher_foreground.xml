<?xml version="1.0" encoding="utf-8"?>
<!--
  Vogel Vault mark — the Apple app icon's Bitcoin glyph, ported to Android.

  What came across from Apple: the letterform and the colourway. Orange ₿ on a
  warm near-black field.

  What did not, and why:
    - "FAMILY BUDGET". Apple sets the old product name under the mark. At 48dp a
      wordmark is an unreadable smear, and the name is wrong since the rename.
    - The chart squiggle. Same reason: it is 2px of detail at launcher size.
    - The gradient. See ic_launcher_background.xml.

  No keyhole. Victor, 2026-08-22: "I am fine with the apple icon and no text."
  The Apple icon has never had one, and he answered the keyhole question by
  choosing the Apple mark as it stands. The earlier keyhole request is superseded.

  Glyph colour is #F7931A, the Bitcoin-branding orange. Apple's raster samples
  #FCB23C at the glyph centre because it carries a gradient; #F7931A is that
  gradient's own base and is the house value for a Bitcoin surface.

  Geometry is v4 candidate C, which Victor approved on shape: spine, two lobes,
  four protruding serif bars, ~54 units tall.

  Safe zone: extremes (48,25.5) and (39,30)-(39,78) sit within 29.1 units of
  centre, inside the r=33 adaptive safe circle; every coordinate is in 18..90.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ₿ spine -->
    <path
        android:strokeColor="#F7931A"
        android:strokeWidth="6"
        android:strokeLineCap="butt"
        android:fillColor="@android:color/transparent"
        android:pathData="M42,30 L42,78" />
    <!-- Upper loop -->
    <path
        android:strokeColor="#F7931A"
        android:strokeWidth="6"
        android:strokeLineCap="butt"
        android:fillColor="@android:color/transparent"
        android:pathData="M42,33 L53,33 A10.5,10.5 0 1,1 53,54 L42,54" />
    <!-- Lower loop, slightly wider like the letterform -->
    <path
        android:strokeColor="#F7931A"
        android:strokeWidth="6"
        android:strokeLineCap="butt"
        android:fillColor="@android:color/transparent"
        android:pathData="M42,54 L54,54 A10.5,10.5 0 1,1 54,75 L42,75" />
    <!-- The four protruding serif bars — the ₿ signature -->
    <path
        android:strokeColor="#F7931A"
        android:strokeWidth="3.4"
        android:strokeLineCap="butt"
        android:fillColor="@android:color/transparent"
        android:pathData="M49,25.5 L49,31.5 M55,25.5 L55,31.5 M49,73.5 L49,79.5 M55,73.5 L55,79.5" />

</vector>
